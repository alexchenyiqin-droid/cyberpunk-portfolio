# 在 Vercel 项目设置中配置这两个环境变量；不要提交真实值。
# ADMIN_PASSWORD：后台登录密码（建议使用 20 位以上随机密码）
# GITHUB_CONTENT_TOKEN：仅授予此仓库 Contents 读写权限的 GitHub Fine-grained PAT 或 GitHub App token
ADMIN_PASSWORD=
GITHUB_CONTENT_TOKEN=

# 可选：默认已指向 alexchenyiqin-droid/cyberpunk-portfolio 的 main 分支。
GITHUB_REPOSITORY_OWNER=alexchenyiqin-droid
GITHUB_REPOSITORY_NAME=cyberpunk-portfolio
GITHUB_CONTENT_BRANCH=main
